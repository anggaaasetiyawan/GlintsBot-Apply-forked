{
  "$schema": "./src/config-schema.json",
  "feed": {
    "pageName": "for_you",
    "pageSize": 10,
    "maxPages": 20,
    "sources": [
      { "type": "recommend", "pageName": "for_you", "maxPages": 20 },
      { "type": "recommend", "pageName": "for_you", "recentlyAdded": true, "maxPages": 10 },
      { "type": "nearby", "maxPages": 10 }
    ]
  },
  "filters": {
    "includeKeywords": ["developer", "engineer", "fullstack", "backend"],
    "excludeKeywords": ["sales", "marketing", "intern"],
    "jobTypes": ["FULL_TIME", "CONTRACT"],
    "workArrangements": ["REMOTE", "HYBRID", "ONSITE"],
    "minYearsOfExperienceMax": 5,
    "remoteOnly": false,
    "skipApplied": true,
    "skipFraudFlagged": true
  },
  "limits": {
    "maxAppliesPerRun": 20,
    "maxAppliesPerDay": 50,
    "minDelaySeconds": 4,
    "maxDelaySeconds": 12
  },
  "answers": {
    "years_of_relevant_experience_v2": "More than 5 years",
    "skill_set_tools": "Expert",
    "skill_set_foreign_language_v2": ["Bahasa Indonesia", "English"],
    "expected_salary_idr": 7000000,
    "skills": ["PHP", "Laravel", "JavaScript", "TypeScript", "Node.js", "MySQL", "Docker"]
  },
  "intro": {
    "enabled": true
  },
  "cron": {
    "schedule": "0 */2 * * *",
    "timezone": "Asia/Jakarta"
  },
  "keywordOptions": {
    "mode": "tech",
    "customTokens": [],
    "extraRoleNouns": []
  },
  "jobstreet": {
    "searchKeywords": ["frontend developer", "web developer"],
    "location": "jakarta",
    "limitPerDay": 50,
    "concurrency": 2,
    "maxPages": 3,
    "maxJobsPerKeyword": 40,
    "dryRun": false,
    "debugTest": 0,
    "minDelaySeconds": 3,
    "maxDelaySeconds": 6,
    "autoKeywords": true,
    "refreshKeywordsEvery": 0,
    "maxAutoKeywords": 12
  }
}
